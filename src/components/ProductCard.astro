---
import { products as sourceProducts } from '../data/products.js';
const { product } = Astro.props;
const { locale = 'en' } = Astro.props;
const base = `/${locale}`;
const sourceName = sourceProducts.find((source) => source.slug === product.slug)?.name || '';
const labels = locale === 'ar' ? { view: 'عرض المنتج', perPack: 'للعبوة (200 قطعة)', perUnit: 'للقطعة' } : { view: 'View product', perPack: 'per pack of 200', perUnit: 'per unit' };
---
<article class="catalogue-card" data-search={`${product.name} ${sourceName} ${product.category} ${product.sku} ${product.description}`}><a class="card-image" href={`${base}/products/${product.slug}/`}><img src={product.image} alt={product.name} width="420" height="320" loading="lazy" /></a><div class="card-copy"><p class="card-family">{product.category}</p><h3><a href={`${base}/products/${product.slug}/`}><bdi dir="ltr">{product.name}</bdi></a></h3><p>{product.description}</p><div class="card-bottom"><div><strong class="locked-price" data-product-price={product.slug}>{locale === 'ar' ? 'سجّل الدخول لعرض السعر' : 'Sign in to view price'}</strong><small>{product.slug === 'nitrile-exam-gloves-m-200' ? labels.perPack : labels.perUnit}</small></div><a class="button button-secondary" href={`${base}/products/${product.slug}/`}>{labels.view} <span aria-hidden="true">↗</span></a></div></div></article>
