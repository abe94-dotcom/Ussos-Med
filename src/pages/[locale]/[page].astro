---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, copy, localePath } from '../../data/i18n.js';
export function getStaticPaths() { return locales.flatMap(locale => ['about', 'privacy', 'terms'].map(page => ({ params: { locale, page } }))); }
const { locale, page } = Astro.params; const ar = locale === 'ar'; const t = copy[locale];
const content = ar ? {
 about: ['عن يوسس ميد', 'مستلزمات دقيقة للعيادات الحديثة في دبي والإمارات.', 'يوسس ميد هو كتالوج وخدمة عرض أسعار لمستلزمات طب الأسنان، ومكوّنات الزرعات، والحلول الرقمية، ومنتجات تقويم الأسنان والمستهلكات.'],
 privacy: ['سياسة الخصوصية', 'معلوماتك موضحة بوضوح.', 'نستخدم بيانات الحساب والبريد الإلكتروني لتسجيل الدخول وحفظ سلة المنتجات وطلبات عروض الأسعار ومتابعتها. تواصل معنا لطلب الوصول إلى بياناتك أو تصحيحها أو حذفها.'],
 terms: ['شروط الاستخدام', 'شروط الكتالوج وطلب عرض السعر.', 'أوصاف المنتجات والأسعار المعروضة لأصحاب الحسابات تساعد العيادات على طلب عرض سعر وليست عرض بيع نهائياً. نؤكد التوفر والتوافق والسعر النهائي قبل قبول الطلب.'],
} : {
 about: ['About USSUS Med', 'Supplies for the detail-driven practice.', 'USSUS Med is a catalogue and quotation service for dental clinics sourcing implant prosthetics, digital solutions, orthodontic supplies, and consumables.'],
 privacy: ['Privacy policy', 'Your information, clearly explained.', 'We use your account and email details to provide sign-in, save your basket and quote requests, and respond to those requests. Contact us to access, correct or delete your information.'],
 terms: ['Terms of use', 'Catalogue and quotation terms.', 'Product descriptions and account-only reference prices help clinics request a quotation; they are not a final offer to sell. Availability, compatibility, and final pricing are confirmed before an order is accepted.'],
}; const [label, heading, body] = content[page];
---
<BaseLayout locale={locale} title={`${label} | USSUS Med`} description={body} noindex={page !== 'about'}><article class="shell quote-page"><p class="kicker">{label}</p><h1>{heading}</h1><p class="detail-intro">{body}</p><section class="product-information"><div><h2>{ar ? 'تواصل معنا' : 'Contact us'}</h2><p>{ar ? 'للاستفسارات، راسلنا على' : 'For questions, email'} <a href="mailto:sales@ussusmed.com">sales@ussusmed.com</a>. <a href="https://wa.me/971502768276" target="_blank" rel="noopener noreferrer">WhatsApp: +971 50 276 8276</a></p></div><dl><div><dt>{ar ? 'الكتالوج' : 'Catalogue'}</dt><dd><a href={localePath(locale, '/products/')}>{ar ? 'استعرض منتجاتنا ومستلزمات عيادتك.' : 'Browse our products and clinic supplies.'}</a></dd></div></dl></section></article></BaseLayout>
