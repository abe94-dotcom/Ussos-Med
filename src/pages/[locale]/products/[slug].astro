---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, copy, localePath } from '../../../data/i18n.js';
import { getProducts, getProduct } from '../../../data/localized-products.js';
export function getStaticPaths() { return locales.flatMap(locale => getProducts(locale).map(product => ({ params: { locale, slug: product.slug } }))); }
const { locale, slug } = Astro.params; const t = copy[locale]; const product = getProduct(locale, slug); const siteUrl = Astro.site || new URL('https://ussusmed.com'); const productUrl = new URL(localePath(locale, `/products/${slug}/`), siteUrl).href;
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', '@id': `${productUrl}#product`, name: product.name, description: product.description, sku: product.sku, category: product.category, image: [new URL(product.image, siteUrl).href], url: productUrl, inLanguage: t.language };
// Technical specifications remain exactly as supplied in the original catalogue.
const originalProduct = getProduct('en', slug);
const specs = originalProduct.specifications;
---
<BaseLayout locale={locale} title={`${product.name} | USSUS Med`} description={product.description} image={product.image} openGraphType="product"><Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(productSchema)} /></Fragment><div class="shell product-page"><p class="breadcrumbs"><a href={localePath(locale)}>{t.common.home}</a><span>/</span><a href={localePath(locale, '/products/')}>{t.common.catalogue}</a><span>/</span><bdi dir="ltr">{product.name}</bdi></p><section class="product-detail"><div class="detail-image"><a href={product.image} target="_blank" rel="noopener" aria-label={product.name}><img src={product.image} alt={product.name} width="720" height="720" /></a><span class="image-hint">{locale === 'ar' ? 'اختر الصورة لعرضها بالحجم الكامل ↗' : 'Select image to view full size ↗'}</span></div><div class="detail-copy"><p class="kicker">{product.category}</p><h1><bdi dir="ltr">{product.name}</bdi></h1><p class="product-sku">{product.sku}</p><p class="detail-intro">{product.description}</p><p class="detail-price"><span class="locked-price" data-product-price={product.slug}>{locale === 'ar' ? 'سجّل الدخول لعرض السعر' : 'Sign in to view price'}</span> <span>{product.slug === 'nitrile-exam-gloves-m-200' ? t.common.perPack : t.common.perUnit}</span></p><p class="pricing-note">{locale === 'ar' ? 'أنشئ حساباً أو سجّل الدخول لعرض الأسعار وإضافة المنتجات إلى طلب عرض السعر.' : 'Create an account or sign in to view prices and add products to a quote request.'}</p><p class="product-account-gate"><a class="button button-primary" href={localePath(locale, '/account/')}>{locale === 'ar' ? 'إنشاء حساب أو تسجيل الدخول' : 'Create account or sign in'}</a></p><form class="product-order" data-slug={product.slug} hidden>{product.heights.length > 0 && <label>{locale === 'ar' ? 'الارتفاع الترميمي' : 'Restorative height'}<select name="height" required><option value="">{locale === 'ar' ? 'اختر الارتفاع' : 'Choose a height'}</option>{product.heights.map(height => <option>{height}</option>)}</select></label>}{product.needsSystem && <><label>{locale === 'ar' ? 'نظام الزرعات (إذا كان معروفاً)' : 'Implant system (if known)'}<input name="system" maxlength="120" placeholder={locale === 'ar' ? 'سنساعدك في تحديده' : 'We can help identify it'} /></label><label>{locale === 'ar' ? 'المنصة أو نوع الوصلة' : 'Platform or connection'}<input name="connection" maxlength="120" placeholder={locale === 'ar' ? 'إن كانت معروفة' : 'If known'} /></label></>}<label class="quantity-label">{locale === 'ar' ? 'الكمية' : 'Quantity'}<input name="quantity" type="number" min="1" max="999" step="1" value="1" required /></label><button class="button button-primary" type="submit">{locale === 'ar' ? 'أضف إلى طلب عرض السعر' : 'Add to quote basket'}</button></form><a class="text-link review-quote" href={localePath(locale, '/quote/')}>{locale === 'ar' ? 'راجع السلة واطلب عرض سعر ←' : 'Review basket and request a quote →'}</a></div></section><section class="product-information"><div><h2>{locale === 'ar' ? 'مواصفات المنتج' : 'Product specifications'}</h2><p>{locale === 'ar' ? 'أضف أي متطلبات إضافية في طلب عرض السعر. يؤكد فريقنا التكوين والتوفر قبل الطلب.' : 'Include any additional requirements in your quote request. Our team will confirm the exact configuration and availability before you order.'}</p></div><dl>{specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section></div></BaseLayout>
