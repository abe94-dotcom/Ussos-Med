---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import ProductCard from '../../../components/ProductCard.astro';
import { locales, copy, localePath } from '../../../data/i18n.js'; import { getProducts, getCategories } from '../../../data/localized-products.js';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params; const t = copy[locale]; const products = getProducts(locale); const categories = getCategories(locale);
const anchor = category => category === 'مكوّنات الزرعات السنية' ? 'implant-prosthetics' : category === 'الحلول الرقمية' ? 'digital-solutions' : category === 'المستهلكات' ? 'consumables' : category === 'تقويم الأسنان' ? 'orthodontics' : category.toLowerCase().replaceAll(' ', '-');
---
<BaseLayout locale={locale} title={locale === 'ar' ? 'كتالوج مستلزمات طب الأسنان | يوسس ميد' : 'Dental supplies catalogue | USSUS Med'} description={locale === 'ar' ? 'كتالوج مستلزمات طب الأسنان ومكونات الزرعات والحلول الرقمية للعيادات في دبي والإمارات.' : 'Browse dental consumables, implant prosthetics, digital dentistry equipment, and orthodontic supplies.'}>
<section class="catalogue-hero"><div class="shell"><p class="breadcrumbs"><a href={localePath(locale)}>{t.common.home}</a><span>/</span>{t.common.catalogue}</p><h1>{t.catalogue.title}</h1><p>{t.catalogue.intro}</p></div></section><section class="shell section catalogue-layout" id="categories"><aside class="catalogue-sidebar"><h2>{t.catalogue.families}</h2>{categories.map(category => <a class="filter-link" href={`#${anchor(category)}`}>{category}</a>)}</aside><div class="catalogue-content"><div class="catalogue-toolbar"><div><h2>{t.catalogue.explore}</h2><p class="pricing-note">{t.common.priced}</p></div><p>{products.length} {locale === 'ar' ? 'منتجات' : 'products'}</p></div>{categories.map(category => <section class="catalogue-group" id={anchor(category)}><h2>{category}</h2><div class="catalogue-grid">{products.filter(product => product.category === category).map(product => <ProductCard product={product} locale={locale} />)}</div></section>)}</div></section><section class="quote-strip"><div class="shell"><div><p class="kicker">{t.catalogue.bulk}</p><h2>{t.catalogue.bulkTitle}</h2></div><a class="button button-primary" href={localePath(locale, '/quote/')}>{t.catalogue.request}</a></div></section>
</BaseLayout>
