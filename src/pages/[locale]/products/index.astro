---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import ProductCard from '../../../components/ProductCard.astro';
import { locales, copy, localePath } from '../../../data/i18n.js'; import { getProducts, getCategoryFilters } from '../../../data/localized-products.js';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params; const t = copy[locale]; const products = getProducts(locale); const categories = getCategoryFilters(locale);
const search = locale === 'ar' ? { label: 'ابحث في المنتجات', placeholder: 'المنتج أو رمز SKU أو الفئة', button: 'بحث', all: 'كل المنتجات', noResults: 'لا توجد منتجات تطابق بحثك. جرّب كلمة أخرى أو اعرض كل المنتجات.', result: 'منتجات' } : { label: 'Search products', placeholder: 'Product, SKU, or category', button: 'Search', all: 'All products', noResults: 'No products match your search. Try another term or view all products.', result: 'products' };
---
<BaseLayout locale={locale} title={locale === 'ar' ? 'كتالوج مستلزمات طب الأسنان | يوسس ميد' : 'Dental supplies catalogue | USSUS Med'} description={locale === 'ar' ? 'كتالوج مستلزمات طب الأسنان ومكونات الزرعات والحلول الرقمية للعيادات في دبي والإمارات.' : 'Browse dental consumables, implant prosthetics, digital dentistry equipment, and orthodontic supplies.'}>
<section class="catalogue-hero"><div class="shell"><p class="breadcrumbs"><a href={localePath(locale)}>{t.common.home}</a><span>/</span>{t.common.catalogue}</p><h1>{t.catalogue.title}</h1><p>{t.catalogue.intro}</p><form class="catalogue-search" action={localePath(locale, '/products/')} method="get" role="search"><label for="catalogue-query">{search.label}</label><div><input id="catalogue-query" name="q" type="search" placeholder={search.placeholder} autocomplete="off" maxlength="120" /><button class="button button-primary" type="submit">{search.button}</button></div></form></div></section><section class="shell section catalogue-layout" id="categories" data-catalogue data-locale={locale}><aside class="catalogue-sidebar"><h2>{t.catalogue.families}</h2><a class="filter-link" data-category-filter="all" href={localePath(locale, '/products/#categories')}>{search.all}</a>{categories.map(category => <a class="filter-link" data-category-filter={category.slug} href={localePath(locale, `/products/?category=${category.slug}#categories`)}>{category.label}</a>)}</aside><div class="catalogue-content"><div class="catalogue-toolbar"><div><h2>{t.catalogue.explore}</h2><p class="pricing-note">{t.common.priced}</p></div><p id="catalogue-result-count" aria-live="polite">{products.length} {search.result}</p></div><p id="catalogue-empty" class="catalogue-empty" hidden>{search.noResults} <a href={localePath(locale, '/products/#categories')}>{search.all}</a></p>{categories.map(category => <section class="catalogue-group" id={category.slug} data-category={category.slug}><h2>{category.label}</h2><div class="catalogue-grid">{products.filter(product => product.category === category.label).map(product => <ProductCard product={product} locale={locale} />)}</div></section>)}</div></section><section class="quote-strip"><div class="shell"><div><p class="kicker">{t.catalogue.bulk}</p><h2>{t.catalogue.bulkTitle}</h2></div><a class="button button-primary" href={localePath(locale, '/quote/')}>{t.catalogue.request}</a></div></section>
</BaseLayout>
