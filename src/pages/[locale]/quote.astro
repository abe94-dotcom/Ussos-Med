---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { locales, copy, localePath } from '../../data/i18n.js';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params; const t = copy[locale]; const ar = locale === 'ar';
---
<BaseLayout locale={locale} title={ar ? 'طلب عرض سعر | يوسس ميد' : 'Your quote request | USSUS Med'} description={ar ? 'اختر منتجات طب الأسنان وأرسل طلب عرض سعر إلى يوسس ميد في دبي.' : 'Review products and quantities and prepare your dental supplies quotation request.'} noindex={true}><div class="shell quote-page"><p class="breadcrumbs"><a href={localePath(locale, '/products/')}>{t.common.catalogue}</a><span>/</span>{ar ? 'طلب عرض سعر' : 'Quote request'}</p><p class="kicker">{ar ? 'لنجهّز طلبك معاً' : 'Let’s put your order together'}</p><h1>{ar ? 'طلب عرض السعر.' : 'Your quote request.'}</h1><p class="detail-intro">{ar ? 'راجع اختيارك وأخبرنا بما تحتاجه. نساعدك في التفاصيل.' : 'Review your selection and tell us what you need. We’ll help with the details.'}</p><div class="quote-layout"><section class="quote-summary"><h2>{ar ? 'المنتجات المختارة' : 'Selected products'}</h2><div id="basket-items"></div><p id="basket-total" class="detail-price"></p><p class="pricing-note">{ar ? 'المجموع الفرعي بالدرهم الإماراتي وليس فاتورة نهائية. يتم تأكيد التوفر والتوافق والضرائب والشحن وموعد التسليم في عرض السعر.' : 'Item subtotal in AED only. This is not a final invoice. Availability, compatibility, taxes, shipping charges and delivery timing will be confirmed in the quotation.'}</p><a class="text-link" href={localePath(locale, '/products/')}>{ar ? 'متابعة التصفح ←' : 'Continue browsing →'}</a></section><section class="quote-contact"><h2>{ar ? 'بياناتك' : 'Your details'}</h2><p class="form-intro">{ar ? 'جهّز طلبك ثم أرسله باستخدام بريدك الإلكتروني.' : 'Prepare your request, then send it using your email service.'}</p><form id="quote-form"><label>{ar ? 'الاسم' : 'Your name'}<input name="name" autocomplete="name" required maxlength="120" /></label><label>{ar ? 'البريد الإلكتروني' : 'Email address'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label><label>{ar ? 'العيادة أو الشركة' : 'Clinic or company'}<input name="clinic" autocomplete="organization" required maxlength="180" /></label><label>{ar ? 'مدينة وبلد التسليم' : 'Delivery city and country'}<input name="destination" required maxlength="180" /></label><label>{ar ? 'منتجات أو متطلبات إضافية' : 'Additional products or requirements'}<textarea name="notes" rows="4" maxlength="3000" placeholder={ar ? 'المنتجات أو المقاسات أو الكميات أو أسئلة التسليم' : 'Products, sizes, quantities, delivery needs or questions'}></textarea></label><p class="pricing-note">{ar ? 'لا يُرسل أي طلب حتى تقوم بإرساله بنفسك.' : 'No request is sent until you send the email yourself.'}</p><button class="button button-primary" type="submit">{ar ? 'جهّز رسالة عرض السعر' : 'Prepare quote email'}</button><p id="form-status" role="status"></p></form></section></div><section id="quote-ready" class="quote-ready" hidden tabindex="-1"><h2>{ar ? 'طلبك جاهز للإرسال' : 'Your request is ready to send'}</h2><p>{ar ? 'لم يتم إرساله بعد. افتح تطبيق بريدك وأرسله إلى orders@ussusmed.com.' : 'It has not been sent. Open your email app and send it to orders@ussusmed.com.'}</p><textarea id="quote-preview" readonly rows="12"></textarea><div class="order-actions"><a id="email-quote" class="button button-primary">{ar ? 'فتح رسالة البريد' : 'Open email draft'}</a><button id="copy-quote" class="button button-secondary" type="button">{ar ? 'نسخ الطلب' : 'Copy request'}</button><a id="download-quote" class="button button-secondary" download="ussus-quote-request.txt">{ar ? 'تنزيل الطلب' : 'Download request'}</a></div><p id="copy-status" role="status"></p></section></div></BaseLayout>
