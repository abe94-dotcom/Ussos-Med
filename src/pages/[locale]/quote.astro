---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { locales, copy, localePath } from '../../data/i18n.js';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params; const t = copy[locale]; const ar = locale === 'ar';
---
<BaseLayout locale={locale} title={ar ? 'طلب عرض سعر | يوسس ميد' : 'Your quote request | USSUS Med'} description={ar ? 'اختر منتجات طب الأسنان وأرسل طلب عرض سعر إلى يوسس ميد في دبي.' : 'Review products and quantities and prepare your dental supplies quotation request.'} noindex={true}><div class="shell quote-page"><p class="breadcrumbs"><a href={localePath(locale, '/products/')}>{t.common.catalogue}</a><span>/</span>{ar ? 'طلب عرض سعر' : 'Quote request'}</p><p class="kicker">{ar ? 'لنجهّز طلبك معاً' : 'Let’s put your order together'}</p><h1>{ar ? 'طلب عرض السعر.' : 'Your quote request.'}</h1><p class="detail-intro">{ar ? 'راجع اختيارك وأخبرنا بما تحتاجه. نساعدك في التفاصيل.' : 'Review your selection and tell us what you need. We’ll help with the details.'}</p><div class="quote-layout"><section class="quote-summary"><h2>{ar ? 'المنتجات المختارة' : 'Selected products'}</h2><div id="basket-items"></div><p id="basket-total" class="detail-price"></p><p class="pricing-note">{ar ? 'المجموع الفرعي بالدرهم الإماراتي وليس فاتورة نهائية. يتم تأكيد التوفر والتوافق والضرائب والشحن وموعد التسليم في عرض السعر.' : 'Item subtotal in AED only. This is not a final invoice. Availability, compatibility, taxes, shipping charges and delivery timing will be confirmed in the quotation.'}</p><a class="text-link" href={localePath(locale, '/products/')}>{ar ? 'متابعة التصفح ←' : 'Continue browsing →'}</a></section><section class="quote-contact"><h2>{ar ? 'بياناتك' : 'Your details'}</h2><p class="form-intro">{ar ? 'أدخل وسيلة التواصل وافتح رسالة جاهزة باللغة الإنجليزية في تطبيق بريدك.' : 'Add your contact details and open a ready-to-send email draft.'}</p><form id="quote-form"><label>{ar ? 'الاسم' : 'Your name'}<input name="name" autocomplete="name" required maxlength="120" /></label><label>{ar ? 'البريد الإلكتروني' : 'Email address'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label><label>{ar ? 'العيادة أو الشركة (اختياري)' : 'Clinic or company (optional)'}<input name="clinic" autocomplete="organization" maxlength="180" /></label><label>{ar ? 'مدينة وبلد التسليم (اختياري)' : 'Delivery city and country (optional)'}<input name="destination" maxlength="180" /></label><label>{ar ? 'منتجات أو متطلبات إضافية (بالإنجليزية)' : 'Additional products or requirements'}<textarea name="notes" rows="4" maxlength="3000" placeholder={ar ? 'اكتب التفاصيل باللغة الإنجليزية' : 'Products, sizes, quantities, delivery needs or questions'}></textarea></label><p class="pricing-note">{ar ? 'ستفتح رسالة في تطبيق بريدك. راجعها وأرسلها بنفسك؛ لن يُرسل الطلب تلقائياً.' : 'Your email app will open a draft. Review and send it there; this form does not send automatically.'}</p><button class="button button-primary" type="submit">{ar ? 'افتح رسالة طلب السعر' : 'Open quote email draft'}</button><p id="form-status" role="status"></p></form></section></div><section id="quote-ready" class="quote-ready" hidden tabindex="-1"><h2>{ar ? 'رسالتك جاهزة للإرسال' : 'Your email draft is ready'}</h2><p>{ar ? 'إذا لم يفتح تطبيق البريد، افتح الرسالة مرة أخرى أو انسخ الطلب وأرسله إلى orders@ussusmed.com. لم يُرسل الطلب بعد.' : 'If your email app did not open, try again or copy the request and email it to orders@ussusmed.com. Your request has not been sent yet.'}</p><textarea id="quote-preview" readonly rows="12" aria-label={ar ? 'معاينة طلب عرض السعر' : 'Quote request preview'}></textarea><div class="order-actions"><a id="email-quote" class="button button-primary">{ar ? 'فتح رسالة البريد' : 'Open email draft'}</a><button id="copy-quote" class="button button-secondary" type="button">{ar ? 'نسخ الطلب' : 'Copy request'}</button><a id="download-quote" class="button button-secondary" download="ussus-quote-request.txt">{ar ? 'تنزيل الطلب' : 'Download request'}</a></div><p id="copy-status" role="status"></p></section></div></BaseLayout>
