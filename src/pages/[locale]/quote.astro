---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, copy, localePath } from '../../data/i18n.js';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params; const t = copy[locale]; const ar = locale === 'ar';
---
<BaseLayout locale={locale} title={ar ? 'طلب عرض سعر | يوسس ميد' : 'Your quote request | USSUS Med'} description={ar ? 'راجع منتجاتك وأرسل طلب عرض سعر.' : 'Review your products and submit a quotation request.'} noindex={true}>
  <div class="shell quote-page">
    <p class="breadcrumbs"><a href={localePath(locale, '/products/')}>{t.common.catalogue}</a><span>/</span>{ar ? 'طلب عرض سعر' : 'Quote request'}</p>
    <p class="kicker">{ar ? 'لنجهّز طلبك معاً' : 'Let’s put your order together'}</p>
    <h1>{ar ? 'طلب عرض السعر.' : 'Your quote request.'}</h1>
    <p class="detail-intro">{ar ? 'أضف المنتجات والكميات. يؤكد فريقنا التوفر والتوافق والأسعار النهائية في عرض السعر.' : 'Review your products and quantities. Our team will confirm availability, compatibility and final pricing in your quotation.'}</p>
    <section class="quote-account-gate account-benefits"><p>{ar ? 'أنشئ حساباً أو سجّل الدخول لاستخدام سلة طلب عرض السعر.' : 'Create an account or sign in to use your quote basket.'}</p><a class="button button-primary" href={localePath(locale, '/account/')}>{ar ? 'إنشاء حساب أو تسجيل الدخول' : 'Create account or sign in'}</a></section><div class="quote-layout" hidden>
      <section class="quote-summary"><h2>{ar ? 'المنتجات المختارة' : 'Selected products'}</h2><div id="basket-items"></div><p id="basket-total" class="detail-price"></p><p class="pricing-note">{ar ? 'المجموع الفرعي بالدرهم الإماراتي مرجعي وليس فاتورة نهائية.' : 'The AED subtotal is for reference and is not a final invoice.'}</p><a class="text-link" href={localePath(locale, '/products/')}>{ar ? 'متابعة التصفح ←' : 'Continue browsing →'}</a></section>
      <section class="quote-contact"><h2>{ar ? 'تفاصيل التسليم' : 'Delivery details'}</h2><p class="form-intro">{ar ? 'سنربط الطلب بحسابك وبريدك الإلكتروني بعد الإرسال.' : 'Your request will be saved to your account and linked to your sign-in email.'}</p>
        <form id="quote-form"><label>{ar ? 'مدينة وبلد التسليم' : 'Delivery city and country'}<input name="destination" maxlength="180" autocomplete="shipping country-name" /></label><label>{ar ? 'ملاحظات إضافية' : 'Additional requirements'}<textarea name="notes" rows="5" maxlength="3000" placeholder={ar ? 'اكتب المتطلبات باللغة الإنجليزية' : 'Sizes, delivery needs or questions'}></textarea></label><p class="pricing-note">{ar ? 'إرسال هذا الطلب لا ينشئ طلب شراء أو يلزمك بالشراء.' : 'Submitting a quote request does not place an order or commit you to purchase.'}</p><button class="button button-primary" type="submit">{ar ? 'إرسال طلب عرض السعر' : 'Submit quote request'}</button><p id="form-status" role="status" aria-live="polite"></p></form>
      </section>
    </div>
  </div>
</BaseLayout>
