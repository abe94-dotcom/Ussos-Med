---
import '../styles/site.css';
const { title = 'USSUS Med | Dental supplies for modern practice', description = 'Dental supplies for modern practice.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06244c" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><div class="shell header-inner"><a class="brand" href="/" aria-label="USSUS Med home"><img src="/images/ussus-logo.jpg" alt="USSUS Med" width="132" height="48" /></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu"><span class="sr-only">Open menu</span><span></span><span></span></button><nav class="site-nav" id="site-menu" aria-label="Main navigation"><a href="/products/">Products</a><a href="/products/#categories">Categories</a><a href="/#for-clinics">For clinics</a><a href="#contact">Contact</a></nav><div class="header-actions"><button class="language-button" type="button" aria-label="Arabic site coming soon">العربية</button><a class="cart-link" href="#cart" aria-label="Shopping cart, 0 items">Cart <span class="cart-count" aria-live="polite">0</span></a></div></div></header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer" id="contact"><div class="shell footer-grid"><div><a class="footer-brand" href="/">USSUS <span>Med</span></a><p>Dental supplies for clinics that care about precision.</p></div><div><h2>Start an order</h2><a href="mailto:orders@ussusmed.com">orders@ussusmed.com</a><a href="tel:+0000000000">Talk to our sales team</a></div><div><h2>Quick links</h2><a href="/products/">Products</a><a href="/products/#categories">Categories</a><a href="/#for-clinics">For clinics</a></div></div><div class="shell footer-bottom"><span>© 2026 USSUS Med</span><span>Built for modern dental practice</span></div></footer>
    <div class="cart-toast" role="status" aria-live="polite">Added to cart</div>
    <script>
      const currencyRates = { AED: 1, USD: 1 / 3.6725, SAR: 3.75 / 3.6725, QAR: 3.64 / 3.6725, OMR: 1 / 9.538713, JOD: 1 / 5.179831, SYP: 1 / 0.030102, BHD: 1 / 9.741379, KWD: 1 / 11.948918 };
      const regionCurrency = { AE: 'AED', SA: 'SAR', QA: 'QAR', OM: 'OMR', JO: 'JOD', SY: 'SYP', BH: 'BHD', KW: 'KWD' };
      const timeZoneCurrency = { 'Asia/Dubai': 'AED', 'Asia/Riyadh': 'SAR', 'Asia/Qatar': 'QAR', 'Asia/Muscat': 'OMR', 'Asia/Amman': 'JOD', 'Asia/Damascus': 'SYP', 'Asia/Bahrain': 'BHD', 'Asia/Kuwait': 'KWD' };
      const digits = { AED: 0, SAR: 0, QAR: 0, USD: 2, OMR: 3, JOD: 3, BHD: 3, KWD: 3, SYP: 0 };
      const chooseCurrency = () => { const saved = localStorage.getItem('ussus_currency'); if (saved && currencyRates[saved]) return saved; const locale = Intl.DateTimeFormat().resolvedOptions().locale; const region = Intl.Locale ? new Intl.Locale(locale).region : undefined; return regionCurrency[region] || timeZoneCurrency[Intl.DateTimeFormat().resolvedOptions().timeZone] || 'USD'; };
      const renderCurrency = (currency) => { const formatter = new Intl.NumberFormat(undefined, { style: 'currency', currency, minimumFractionDigits: digits[currency], maximumFractionDigits: digits[currency] }); document.querySelectorAll('[data-price-aed]').forEach((node) => node.textContent = formatter.format(Number(node.dataset.priceAed) * currencyRates[currency])); };
      const selector = document.createElement('select'); selector.className = 'currency-selector'; selector.ariaLabel = 'Display currency'; [['AED','AED'],['SAR','SAR'],['QAR','QAR'],['OMR','OMR'],['JOD','JOD'],['SYP','SYP'],['BHD','BHD'],['KWD','KWD'],['USD','USD']].forEach(([value,label]) => selector.add(new Option(label,value))); selector.value = chooseCurrency(); selector.onchange = () => { localStorage.setItem('ussus_currency', selector.value); renderCurrency(selector.value); }; document.querySelector('.language-button')?.after(selector); renderCurrency(selector.value);
      const menuButton = document.querySelector('.menu-toggle'); const navigation = document.querySelector('.site-nav'); menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); navigation?.classList.toggle('is-open', !open); });
      let count = 0; document.querySelectorAll('.add-button').forEach((button) => button.addEventListener('click', () => { count += 1; document.querySelector('.cart-count').textContent = String(count); const toast = document.querySelector('.cart-toast'); toast.textContent = `${button.dataset.product} added to cart`; toast.classList.add('is-visible'); setTimeout(() => toast.classList.remove('is-visible'), 2400); }));
    </script>
  </body>
</html>
