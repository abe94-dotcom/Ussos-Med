---
import '../styles/site.css';
const { title = 'USSUS Med | Dental supplies for modern practice', description = 'Dental supplies for modern practice.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06244c" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><div class="shell header-inner"><a class="brand" href="/" aria-label="USSUS Med home"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span><span class="wordmark">USSUS<span>med</span></span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu"><span class="sr-only">Open menu</span><span></span><span></span></button><nav class="site-nav" id="site-menu" aria-label="Main navigation"><a href="/products/">Products</a><a href="/products/#categories">Categories</a><a href="/#for-clinics">For clinics</a><a href="#contact">Contact</a></nav><div class="header-actions"><select class="currency-selector" aria-label="Display currency"><option value="AED">AED</option><option value="USD">USD (est.)</option><option value="SAR">SAR (est.)</option><option value="QAR">QAR (est.)</option><option value="OMR">OMR (est.)</option><option value="JOD">JOD (est.)</option><option value="SYP">SYP (est.)</option><option value="BHD">BHD (est.)</option><option value="KWD">KWD (est.)</option></select><a class="cart-link" href="/quote/" aria-label="Quote basket, 0 items">Quote <span class="cart-count" aria-live="polite">0</span></a></div></div></header>
    <main id="main-content"><slot /></main><noscript><p class="shell">The quote basket requires JavaScript. Email your product names and quantities to <a href="mailto:orders@ussusmed.com">orders@ussusmed.com</a>.</p></noscript>
    <footer class="site-footer" id="contact"><div class="shell footer-grid"><div><a class="footer-brand" href="/">USSUS <span>med</span></a><p>Dental supplies for clinics that care about precision.</p></div><div><h2>Start an order</h2><a href="mailto:orders@ussusmed.com">orders@ussusmed.com</a><a href="/quote/">Prepare a quote request</a><p>Delivery area, timing, taxes and shipping charges are confirmed in your quotation.</p></div><div><h2>Quick links</h2><a href="/products/">Products</a><a href="/products/#categories">Categories</a><a href="/#for-clinics">For clinics</a></div></div><div class="shell footer-bottom"><span>© 2026 USSUS Med</span><span>Precision, in every detail.</span></div></footer>
    <div class="cart-toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/storefront.js';</script>
  </body>
</html>
