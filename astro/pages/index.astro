---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories } from '../data/products.js';
---
<BaseLayout description="USSUS Med supplies dental clinics with dependable instruments, implant prosthetics, digital solutions, and everyday consumables.">
  <section class="hero"><div class="shell hero-grid"><div class="hero-copy"><p class="kicker">Dental supply, simplified</p><h1>Precision supplies for modern dentistry.</h1><p class="hero-intro">Dependable instruments, clear pricing, and quick local delivery for the work your practice does every day.</p><div class="hero-actions"><a class="button button-primary" href="/products/">Browse the catalogue</a><a class="button button-secondary" href="#contact">Request a quote</a></div><dl class="confidence-list"><div><dt>Clinic-grade</dt><dd>Quality you can trust</dd></div><div><dt>Ready to ship</dt><dd>Stocked locally</dd></div><div><dt>For practice</dt><dd>From one chair to many</dd></div></dl></div><article class="hero-product"><p>Featured instrument</p><img src="/images/hero_handpiece.jpg" alt="Dental handpiece ready for clinical use" width="720" height="540" /><div><span class="in-stock">In stock</span><h2>High-speed dental handpiece</h2><p>Designed for smooth, controlled daily procedures and a comfortable clinical workflow.</p><a class="text-link" href="/products/">View the catalogue</a></div></article></div></section>
  <section class="section categories" id="categories"><div class="shell"><div class="section-heading split-heading"><div><p class="kicker">Browse by discipline</p><h2>Stock the whole practice.</h2></div><p>One catalogue for routine appointments, restorative planning, and the tools that keep a clinic running.</p></div><div class="category-grid">{categories.map((category, index) => <a class="category-card" href={`/products/#${category.toLowerCase().replaceAll(' ', '-')}`}><span class="category-number">0{index + 1}</span><h3>{category}</h3><p>Browse products selected for dependable clinical work.</p></a>)}</div></div></section>
  <section class="section products"><div class="shell"><div class="section-heading products-heading"><div><p class="kicker">Selected for daily practice</p><h2>Tools worth reaching for.</h2></div><a class="text-link" href="/products/">View all products</a></div><div class="product-grid">{products.slice(0, 3).map((product) => <ProductCard product={product} />)}</div></div></section>
  <section class="clinic-note section" id="for-clinics"><div class="shell clinic-grid"><div><p class="kicker">Less time sourcing</p><h2>More time with patients.</h2></div><div class="clinic-copy"><p>We make replenishing and planning stock simpler: dependable lines, clear availability, and people who understand a dental order.</p><a class="text-link" href="#contact">Talk to the USSUS team</a></div></div></section>
</BaseLayout>
