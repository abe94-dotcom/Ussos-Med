---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories } from '../data/products.js';
const families = [
 { image: '/images/sis_tibase.png', text: 'Components for implant restoration.' },
 { image: '/images/featured_scanner.jpg', text: 'Scanning and CAD/CAM essentials.' },
 { image: '/images/bestseller_gloves.jpg', text: 'Everyday essentials for your clinic.' },
 { image: '/images/mosaic_brackets.jpg', text: 'Supplies for orthodontic treatment.' },
];
---
<BaseLayout description="Explore dental supplies, implant prosthetics and digital equipment for your practice. Build your quotation with USSUS Med.">
<section class="hero"><div class="shell hero-grid">
<div class="hero-copy"><p class="kicker">For the detail-driven practice</p><h1>Precision starts<br />with the essentials.</h1><p class="hero-intro">Implant components, digital equipment and daily supplies. Considered for the way you work.</p><div class="hero-actions"><a class="button button-primary" href="/products/">Explore the catalogue <span aria-hidden="true">↗</span></a><a class="text-link" href="/quote/">Build a quote</a></div></div>
<a class="hero-product" href="/products/sis-smart-tibase-engaging/" aria-label="Explore SIS Smart Ti-Base Engaging"><img src="/images/sis_tibase.png" alt="Silver SIS titanium base components" width="720" height="720" fetchpriority="high" /><div class="hero-caption"><div><span>Implant prosthetics</span><h2>SIS Smart Ti-Base</h2></div><span class="round-link" aria-hidden="true">↗</span></div></a>
</div><div class="shell hero-foot"><span>Supplies for modern dentistry</span><span>Explore. Select. Request a quotation.</span></div></section>
<section class="section categories" id="categories"><div class="shell"><div class="section-heading"><h2>Find your field.</h2><p>Four disciplines. One place to source.</p></div><div class="category-grid">{categories.map((category,index) => <a class="category-card" href={`/products/#${category.toLowerCase().replaceAll(' ', '-')}`}><div class="category-image"><img src={families[index].image} alt="" width="420" height="320" loading="lazy" /></div><div class="category-copy"><h3>{category}<span aria-hidden="true">↗</span></h3><p>{families[index].text}</p></div></a>)}</div></div></section>
<section class="section products"><div class="shell"><div class="section-heading"><div><p class="kicker">A closer look</p><h2>Selected from the catalogue.</h2></div><a class="text-link" href="/products/">Explore all products <span aria-hidden="true">↗</span></a></div><div class="product-grid">{products.slice(0,3).map(product => <ProductCard product={product} />)}</div><p class="collection-note">Billing in AED. Other currencies are estimates. Availability, tax and delivery are confirmed with your quotation.</p></div></section>
<section class="clinic-note section" id="for-clinics"><div class="shell clinic-grid"><div><p class="kicker">For your next order</p><h2>A considered selection.<br />A clear quotation.</h2></div><div class="clinic-copy"><p>Select your products and quantities. Tell us what your practice needs. We’ll confirm the configuration, availability and delivery details in your quotation.</p><a class="button button-light" href="/quote/">Build your quote <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
