---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Your quote request | USSUS Med" description="Review products and quantities and prepare your dental supplies quotation request.">
<div class="shell quote-page"><p class="breadcrumbs"><a href="/products/">Catalogue</a><span>/</span>Quote request</p><p class="kicker">Let’s put your order together</p><h1>Your quote request.</h1><p class="detail-intro">Review your selection and tell us what you need. We’ll help with the details.</p>
<div class="quote-layout"><section class="quote-summary" aria-labelledby="basket-title"><h2 id="basket-title">Selected products</h2><div id="basket-items"></div><p id="basket-total" class="detail-price"></p><p class="pricing-note">Item subtotal in AED only. This is not a final invoice. Availability, compatibility, taxes, shipping charges and delivery timing will be confirmed in the quotation.</p><a class="text-link" href="/products/">Continue browsing →</a></section>
<section class="quote-contact"><h2>Your details</h2><p class="form-intro">Prepare your request, then send it using your email service.</p><form id="quote-form">
<label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
<label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
<label>Clinic or company<input name="clinic" autocomplete="organization" required maxlength="180" /></label>
<label>Delivery city and country<input name="destination" required maxlength="180" autocomplete="off" /></label>
<label>Additional products or requirements<textarea name="notes" rows="4" maxlength="3000" placeholder="Products, sizes, quantities, delivery needs or questions"></textarea></label>
<p class="pricing-note">Your contact details are used to prepare this email and are not saved in the basket. No request is sent until you send the email yourself.</p>
<button class="button button-primary" type="submit">Prepare quote email</button><p id="form-status" role="status"></p>
</form></section></div>
<section id="quote-ready" class="quote-ready" hidden tabindex="-1" aria-labelledby="ready-title"><h2 id="ready-title">Your request is ready to send</h2><p>It has not been sent. Open your email app and send it to <strong>orders@ussusmed.com</strong>, or copy/download the text and send it using your preferred email service.</p><textarea id="quote-preview" aria-label="Prepared quote request" readonly rows="12"></textarea><div class="order-actions"><a id="email-quote" class="button button-primary">Open email draft</a><button id="copy-quote" class="button button-secondary" type="button">Copy request</button><a id="download-quote" class="button button-secondary" download="ussus-quote-request.txt">Download request</a></div><p id="copy-status" role="status"></p><p>Your basket remains saved so you can return to it.</p></section>
</div>
</BaseLayout>
