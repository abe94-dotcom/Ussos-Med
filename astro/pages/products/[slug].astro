---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const structuredData = { '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.description, sku: product.sku };
---
<BaseLayout title={`${product.name} | USSUS Med`} description={product.description}>
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /></Fragment>
<div class="shell product-page">
  <p class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span>{product.name}</p>
  <section class="product-detail">
    <div class="detail-image"><a href={product.image} target="_blank" rel="noopener" aria-label={`Open full-size image of ${product.name}`}><img src={product.image} alt={product.name} width="720" height="720" /></a><span class="image-hint">Select image to view full size ↗</span></div>
    <div class="detail-copy"><p class="kicker">{product.category}</p><h1>{product.name}</h1><p class="product-sku">{product.sku}</p><p class="detail-intro">{product.description}</p>
      <p class="detail-price"><span data-price-aed={product.price}>AED {product.price.toLocaleString()}</span> <span>{product.unit}</span></p>
      <p class="pricing-note">Quoted in AED. Availability confirmed with your quote.</p><details class="price-details"><summary>Pricing &amp; delivery details</summary><p>Converted prices are reference estimates, not live exchange rates. Final taxes, shipping charges and delivery timing will be confirmed in your quotation.</p></details>
      <form class="product-order" data-slug={product.slug}>
        {product.heights.length > 0 && <label>Restorative height<select name="height" required><option value="">Choose a height</option>{product.heights.map(height => <option>{height}</option>)}</select></label>}
        {product.needsSystem && <label>Implant system and connection<input name="system" required maxlength="180" placeholder="Brand, system and platform" /><small>Unsure? Enter “Please advise” and we’ll help confirm compatibility.</small></label>}
        <label class="quantity-label">Quantity<input name="quantity" type="number" min="1" max="999" step="1" value="1" required /></label>
        <button class="button button-primary" type="submit">Add to quote basket</button>
      </form>
      <a class="text-link review-quote" href="/quote/">Review basket and request a quote →</a>
    </div>
  </section>
  <section class="product-information"><div><h2>Product specifications</h2><p>Include any additional requirements in your quote request. Our team will confirm the exact configuration and availability before you order.</p></div><dl>{product.specifications.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
</div>
</BaseLayout>
