---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories } from '../../data/products.js';
---
<BaseLayout title="Dental supplies catalogue | USSUS Med" description="Browse USSUS Med dental consumables, implant prosthetics, digital dentistry equipment, and orthodontic supplies.">
  <section class="catalogue-hero"><div class="shell"><p class="breadcrumbs"><a href="/">Home</a><span>/</span> Catalogue</p><h1>The catalogue.</h1><p>Explore clinic essentials, implant prosthetics, digital equipment, and orthodontic supplies.</p></div></section>
  <section class="shell section catalogue-layout" id="categories"><aside class="catalogue-sidebar"><h2>Product families</h2>{categories.map((category) => <a class="filter-link" href={`#${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</a>)}</aside><div class="catalogue-content"><div class="catalogue-toolbar"><div><h2>Explore the collection</h2><p class="pricing-note">Prices are quoted in AED. Converted values are reference estimates, not live exchange rates. Taxes, shipping and delivery timing are confirmed in your quotation.</p></div><p>{products.length} products</p></div>{categories.map((category) => <section class="catalogue-group" id={category.toLowerCase().replaceAll(' ', '-')}><h2>{category}</h2><div class="catalogue-grid">{products.filter((product) => product.category === category).map((product) => <ProductCard product={product} />)}</div></section>)}</div></section>
  <section class="quote-strip"><div class="shell"><div><p class="kicker">Need a bulk order?</p><h2>Your practice. Your requirements.</h2></div><a class="button button-primary" href="/quote/">Request a quote</a></div></section>
</BaseLayout>
