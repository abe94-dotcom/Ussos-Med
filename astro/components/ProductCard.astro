---
const { product } = Astro.props;
---
<article class="catalogue-card"><a class="card-image" href={`/products/${product.slug}/`}><img src={product.image} alt={product.name} width="420" height="320" loading="lazy" /></a><div class="card-copy"><p class="card-family">{product.category}</p><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3><p>{product.description}</p><div class="card-bottom"><div><strong data-price-aed={product.price}>AED {product.price.toLocaleString()}</strong><small>{product.unit}</small></div><a class="button button-secondary" href={`/products/${product.slug}/`}>View product <span aria-hidden="true">↗</span></a></div></div></article>
