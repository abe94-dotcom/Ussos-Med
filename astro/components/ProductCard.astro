---
const { product } = Astro.props;
---
<article class="catalogue-card"><a class="card-image" href={`/products/${product.slug}/`}><img src={product.image} alt={product.name} width="420" height="320" /></a><div class="card-copy"><p class="card-family">{product.category}</p><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3><p>{product.description}</p><div class="card-bottom"><strong data-price-aed={product.price}>AED {product.price.toLocaleString()}</strong><button class="add-button" type="button" data-product={product.name}>Add</button></div></div></article>
